{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.corosus.watut.WatutMod"
    ],
    "client": [
      "com.corosus.watut.client.WatutClientMod"
    ]
  },
  "mixins": [
    "watut.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "coroutil": ">=26.2.0-1.3.8",
    "fabric-api": "*",
    "minecraft": ">=26.2",
    "java": ">=25"
  }
}
